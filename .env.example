# ---------------------------------------------------------------------------
# Leave every value blank to run in DEMO MODE (in-memory store seeded with the
# Unicorn Club roster). Fill them in to run against real Supabase + Stripe.
# ---------------------------------------------------------------------------

# Supabase -------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by the seed script and by
# webhook handlers that must write across tenants.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs for the platform subscription tiers (see docs/architecture.md)
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_HOUSE=

# App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
